---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { KNOWLEDGE_ARTICLES } from '../../data/knowledge';

const pageTitle = "Commercial Property & Facilities Knowledge Hub | Parker's Commercial";
const pageDescription = "Authoritative UK compliance guides, building regulations, CQC clinical sanitation protocols, and commercial property maintenance standards from Parker's Commercial.";
const canonical = "https://parkerscommercial.co.uk/knowledge";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonical,
  "publisher": {
    "@type": "Organization",
    "name": "Parker's Commercial Cleaning",
    "url": "https://parkerscommercial.co.uk"
  }
};
---

<BaseLayout 
    title={pageTitle}
    description={pageDescription}
    canonicalUrl={canonical}
    schema={schema}
>
    <Navbar slot="header" />

    <!-- Hero Header -->
    <header class="pt-36 pb-20 bg-brand-900 text-white relative overflow-hidden border-b border-white/10">
        <div class="absolute inset-0 bg-gradient-to-r from-brand-900 via-brand-900/90 to-slate-900 z-10"></div>
        <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-20">
            <div class="max-w-3xl">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-accent/20 border border-brand-accent/30 text-brand-accent text-xs font-semibold uppercase tracking-wider mb-6">
                    <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
                    B2B Commercial Knowledge Hub
                </div>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white tracking-tight leading-tight mb-6">
                    Compliance, Standards &amp; Facilities Guides
                </h1>
                <p class="text-slate-300 text-lg md:text-xl font-light leading-relaxed mb-8">
                    In-depth technical guides, statutory building regulations, and operational best practices for managing agents, facilities directors, and corporate decision-makers across London and Essex.
                </p>
                <div class="flex flex-wrap items-center gap-4 text-xs text-slate-300">
                    <span class="flex items-center gap-1.5"><i data-lucide="shield-check" class="w-4 h-4 text-brand-accent"></i> UK Regulations Compliant</span>
                    <span class="flex items-center gap-1.5"><i data-lucide="file-text" class="w-4 h-4 text-brand-accent"></i> Audit-Ready Checklists</span>
                    <span class="flex items-center gap-1.5"><i data-lucide="users" class="w-4 h-4 text-brand-accent"></i> RTM &amp; Small Business Friendly</span>
                    <span class="flex items-center gap-1.5"><i data-lucide="clock" class="w-4 h-4 text-brand-accent"></i> Updated for 2026 Standards</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Category Filter Tabs -->
    <section class="py-6 bg-white border-b border-slate-200 sticky top-20 z-30 shadow-sm backdrop-blur-md bg-white/95">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-wrap items-center justify-between gap-4">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Filter by Sector:</span>
            <div id="filter-tabs" class="flex flex-wrap gap-2 text-xs font-medium">
                <button type="button" data-filter="all" class="filter-btn active px-3.5 py-1.5 rounded-lg bg-brand-900 text-white font-semibold transition-all shadow-sm">
                    All Guides ({KNOWLEDGE_ARTICLES.length})
                </button>
                <button type="button" data-filter="Residential & Small Blocks" class="filter-btn px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all">
                    Residential &amp; Small Blocks
                </button>
                <button type="button" data-filter="Small Business & Retail" class="filter-btn px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all">
                    Small Business &amp; Retail
                </button>
                <button type="button" data-filter="Property Management" class="filter-btn px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all">
                    Property Management
                </button>
                <button type="button" data-filter="Compliance & Regulations" class="filter-btn px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all">
                    Compliance &amp; Regulations
                </button>
                <button type="button" data-filter="External Maintenance" class="filter-btn px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all">
                    External Facades
                </button>
                <button type="button" data-filter="Healthcare & Clinical" class="filter-btn px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all">
                    Healthcare &amp; CQC
                </button>
            </div>
        </div>
    </section>

    <!-- Articles Grid Section -->
    <section class="py-20 bg-slate-50">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {KNOWLEDGE_ARTICLES.map((article) => (
                    <article data-category={article.category} class="article-card bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm hover:shadow-xl hover:border-brand-500/30 transition-all duration-300 flex flex-col justify-between group">
                        <div>
                            <div class="flex items-center justify-between gap-4 mb-4">
                                <span class="px-3 py-1 rounded-md text-[11px] font-semibold uppercase tracking-wider bg-brand-50 text-brand-700 border border-brand-100">
                                    {article.category}
                                </span>
                                <span class="text-xs text-slate-400 font-medium">{article.readTime}</span>
                            </div>

                            <h2 class="text-2xl font-heading font-bold text-slate-900 group-hover:text-brand-600 transition-colors leading-snug mb-3">
                                <a href={`/knowledge/${article.slug}`}>
                                    {article.title}
                                </a>
                            </h2>

                            <p class="text-slate-600 text-sm leading-relaxed mb-6 font-light">
                                {article.summary}
                            </p>
                        </div>

                        <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
                            <div class="text-xs text-slate-500">
                                By <span class="font-semibold text-slate-700">{article.author.name}</span>
                            </div>
                            <a href={`/knowledge/${article.slug}`} class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-600 group-hover:text-brand-700 transition-colors">
                                Read Guide <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
                            </a>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Contextual CTA Banner -->
            <div class="mt-16 bg-gradient-to-br from-brand-900 to-slate-900 rounded-3xl p-8 md:p-12 text-white shadow-2xl relative overflow-hidden border border-white/10">
                <div class="max-w-2xl relative z-10">
                    <span class="text-brand-accent text-xs font-bold uppercase tracking-widest block mb-2">Need Bespoke Advice for Your Premises?</span>
                    <h3 class="text-3xl font-heading font-bold mb-4">Book a Free Site Walkthrough &amp; Compliance Audit</h3>
                    <p class="text-slate-300 text-sm leading-relaxed mb-6">
                        Speak directly with our senior surveying team. We review high-reach access, communal caretaking schedules, or clinical hygiene requirements and provide a fully costed, SLA-backed proposal within 24–48 hours.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a href="/contact" class="bg-brand-accent text-brand-900 px-6 py-3 rounded-xl font-heading font-bold text-xs uppercase tracking-wider hover:bg-white transition-all shadow-md">
                            Request Site Survey
                        </a>
                        <a href="tel:02046206344" class="border border-white/20 hover:border-white text-white px-6 py-3 rounded-xl font-heading font-bold text-xs uppercase tracking-wider hover:bg-white/10 transition-all">
                            Call 020 4620 6344
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Filtering Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const buttons = document.querySelectorAll('.filter-btn');
            const articles = document.querySelectorAll('.article-card');

            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const filter = btn.getAttribute('data-filter');

                    // Update button styling
                    buttons.forEach(b => {
                        b.classList.remove('bg-brand-900', 'text-white', 'font-semibold', 'shadow-sm');
                        b.classList.add('bg-slate-100', 'text-slate-700');
                    });
                    btn.classList.remove('bg-slate-100', 'text-slate-700');
                    btn.classList.add('bg-brand-900', 'text-white', 'font-semibold', 'shadow-sm');

                    // Filter articles
                    articles.forEach(article => {
                        const category = article.getAttribute('data-category');
                        if (filter === 'all' || category === filter) {
                            article.style.display = 'flex';
                        } else {
                            article.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>

    <Footer slot="footer" />
</BaseLayout>
