---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Contact Parker's Commercial Cleaning | Site Surveys & Quotes London & Essex";
const pageDescription = "Contact Parker's Commercial Cleaning to arrange a comprehensive commercial site survey and receive a tailored contract maintenance quote.";
const canonical = "https://parkerscommercial.co.uk/contact";

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Parker's Commercial Cleaning",
  "url": canonical,
  "mainEntity": {
    "@type": "CleaningService",
    "name": "Parker's Commercial Cleaning",
    "telephone": "+442046206344",
    "email": "contact@parkerscommercial.co.uk",
    "areaServed": ["London", "Essex"]
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonical} schema={schema}>
    <Navbar slot="header" />

    <main class="bg-brand-900 relative min-h-screen py-16 lg:py-24 flex items-center">
        <div class="grid grid-cols-1 lg:grid-cols-2 w-full max-w-7xl mx-auto px-6 lg:px-12 gap-12 items-center">
            
            <!-- Left Info Panel -->
            <div class="text-white space-y-8">
                <div class="inline-flex items-center gap-3">
                    <span class="text-brand-accent text-xs tracking-[0.3em] uppercase font-bold">Direct Line</span>
                    <div class="h-[1px] w-12 bg-white/20"></div>
                </div>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white uppercase tracking-tight">
                    Initiate a Strategy Session.
                </h1>
                <p class="text-slate-300 font-light text-base md:text-lg leading-relaxed max-w-lg">
                    Contact us today to arrange a site visit and receive a comprehensive proposal for a contract maintenance plan that perfectly aligns with your infrastructure and budget.
                </p>
                
                <div class="space-y-6 pt-4 border-t border-white/10">
                    <div>
                        <p class="text-white/40 text-[10px] tracking-[0.2em] uppercase font-medium mb-1">Direct Line</p>
                        <a href="tel:02046206344" class="text-white text-3xl font-heading hover:text-brand-accent transition-colors font-bold">020 4620 6344</a>
                    </div>
                    
                    <div>
                        <p class="text-white/40 text-[10px] tracking-[0.2em] uppercase font-medium mb-1">Email Address</p>
                        <a href="mailto:contact@parkerscommercial.co.uk" class="text-white text-base font-light hover:text-brand-accent transition-colors">contact@parkerscommercial.co.uk</a>
                    </div>

                    <div>
                        <p class="text-white/40 text-[10px] tracking-[0.2em] uppercase font-medium mb-1">Operating Region</p>
                        <p class="text-white font-light text-base">Greater London, City of London &amp; Essex</p>
                    </div>
                </div>
            </div>

            <!-- Right Form Panel -->
            <div class="bg-white p-8 md:p-12 rounded-2xl shadow-2xl text-slate-800">
                <div class="mb-8">
                    <h3 class="text-2xl md:text-3xl font-heading font-bold text-brand-900 uppercase tracking-wide mb-2">Request A Quote</h3>
                    <p class="text-xs text-slate-500 font-light">Fill in your details below and our team will respond within 24 hours.</p>
                </div>

                <form id="contactForm" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
                    <input type="hidden" name="access_key" value="0e562e4d-f4ff-4f74-b3d8-16869cd744de">
                    <input type="hidden" name="subject" value="New Commercial Contact Inquiry">
                    <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-brand-900 uppercase tracking-wider mb-1" for="first_name">First Name *</label>
                            <input type="text" id="first_name" name="first_name" required class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-brand-500">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-brand-900 uppercase tracking-wider mb-1" for="last_name">Last Name *</label>
                            <input type="text" id="last_name" name="last_name" required class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-brand-500">
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-brand-900 uppercase tracking-wider mb-1" for="email">Work Email *</label>
                            <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-brand-500">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-brand-900 uppercase tracking-wider mb-1" for="phone">Phone Number</label>
                            <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-brand-500">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-brand-900 uppercase tracking-wider mb-1" for="company">Company Name</label>
                            <input type="text" id="company" name="company" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-brand-500">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-brand-900 uppercase tracking-wider mb-1" for="service">Service Required *</label>
                            <select id="service" name="service" required class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-brand-500">
                                <option value="" disabled selected>Select a service...</option>
                                <option value="Commercial Gutter Cleaning & High-Reach Clearance">Commercial Gutter Cleaning &amp; High-Reach Clearance</option>
                                <option value="Property Management & Block Cleaning">Property Management &amp; Block Cleaning</option>
                                <option value="Ongoing Contract Maintenance">Ongoing Contract Maintenance</option>
                                <option value="Commercial & Industrial Cleaning">Commercial &amp; Industrial Cleaning</option>
                                <option value="Healthcare & CQC Sanitation">Healthcare &amp; CQC Sanitation</option>
                                <option value="Warehouse & Factory Cleaning">Warehouse &amp; Factory Cleaning</option>
                                <option value="High-Level Cladding & Facade Washing">High-Level Cladding &amp; Facade Washing</option>
                                <option value="Post-Construction Sparkle">Post-Construction Sparkle</option>
                                <option value="Other">Other / General Inquiry</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-brand-900 uppercase tracking-wider mb-1" for="message">Additional Details</label>
                        <textarea id="message" name="message" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-brand-500" placeholder="Tell us a little about your facility or required services..."></textarea>
                    </div>

                    <button type="submit" class="w-full py-4 bg-brand-900 text-white rounded-lg font-heading text-sm font-semibold uppercase tracking-wider hover:bg-brand-accent hover:text-brand-900 transition-all shadow-lg">
                        Submit Inquiry
                    </button>
                </form>
            </div>

        </div>
    </main>

    <Footer slot="footer" />
</BaseLayout>
