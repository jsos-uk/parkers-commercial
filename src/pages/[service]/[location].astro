---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { LOCATIONS, SERVICES, type LocationData, type ServiceData } from '../../data/locations';

export function getStaticPaths() {
  const commercialServices = SERVICES.filter(s => s.division === 'commercial');
  const commercialLocations = LOCATIONS.filter(l => l.commercialFocus);

  const paths = [];

  for (const service of commercialServices) {
    for (const location of commercialLocations) {
      paths.push({
        params: {
          service: service.slug,
          location: location.slug
        },
        props: {
          service,
          location
        }
      });
    }
  }

  return paths;
}

interface Props {
  service: ServiceData;
  location: LocationData;
}

const { service, location } = Astro.props;

const postcodesList = location.postcodes.join(', ');
const pageTitle = `${service.name} ${location.name} | Parker's Commercial`;
const pageDescription = `Specialist ${service.name.toLowerCase()} in ${location.name} (${postcodesList}). Trusted by facilities managers & property owners. £10M insured. Book a free site survey.`;
const canonical = `https://parkerscommercial.co.uk/${service.slug}/${location.slug}`;

// Clean Schema
const localSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CleaningService",
      "@id": "https://parkerscommercial.co.uk/#organization",
      "name": "Parker's Commercial Cleaning",
      "url": "https://parkerscommercial.co.uk/",
      "telephone": "+442046206344",
      "priceRange": "££",
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": location.name,
        "postalCode": location.postcodes
      }
    },
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      "name": `${service.name} in ${location.name}`,
      "serviceType": service.name,
      "provider": {
        "@id": "https://parkerscommercial.co.uk/#organization"
      },
      "description": pageDescription
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": `How quickly can you assess premises in ${location.name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `We can typically arrange a walkthrough and deliver a bespoke fixed-price proposal within 24 to 48 hours for facilities in ${location.name}.`
          }
        },
        {
          "@type": "Question",
          "name": `Are your cleaning operatives vetted and insured?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Yes. All operatives are directly employed, DBS background-checked, and uniformed. We maintain £10M Public and Employers Liability insurance and issue site-specific RAMS before day one.`
          }
        },
        {
          "@type": "Question",
          "name": `Can cleaning be conducted out-of-hours in ${location.name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Yes. Most commercial clients choose early morning, late evening, or weekend keyholder shifts to ensure zero daytime disruption.`
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonical} schema={localSchema}>
    <Navbar slot="header" />

    <!-- 1. Hero Section (Clean, Confident, Direct) -->
    <header class="relative bg-brand-900 text-white pt-24 pb-20 md:pt-36 md:pb-28 overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center opacity-20" style={`background-image: url('${service.heroImage}');`}></div>
        <div class="absolute inset-0 bg-gradient-to-b from-brand-900/90 via-brand-900/95 to-brand-900"></div>

        <div class="max-w-5xl mx-auto px-6 text-center relative z-10">
            <!-- Location Badge -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-brand-accent text-xs font-medium uppercase tracking-widest mb-6">
                <span>{location.name}</span>
                <span class="text-white/40">•</span>
                <span>{postcodesList}</span>
            </div>

            <!-- Primary Headline -->
            <h1 class="text-4xl md:text-6xl font-heading font-bold uppercase tracking-tight text-white mb-6 leading-tight">
                {service.name}
                <span class="text-brand-accent block mt-2">{location.name}</span>
            </h1>

            <!-- Direct Value Proposition -->
            <p class="text-lg md:text-xl text-slate-300 font-light max-w-2xl mx-auto leading-relaxed mb-10">
                {service.leadParagraph}
            </p>

            <!-- Dual Primary Actions -->
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="/contact" class="bg-brand-accent text-brand-900 px-8 py-4 rounded-lg font-heading text-sm uppercase tracking-wider font-bold hover:bg-white transition-all shadow-lg hover:shadow-cyan-500/20">
                    Book Free Site Survey
                </a>
                <a href="tel:02046206344" class="px-8 py-4 rounded-lg font-heading text-sm uppercase tracking-wider font-semibold border border-white/30 text-white hover:bg-white/10 transition-all flex items-center gap-2">
                    <i data-lucide="phone" class="w-4 h-4 text-brand-accent"></i>
                    <span>020 4620 6344</span>
                </a>
            </div>

            <!-- Core Trust Signals Bar -->
            <div class="mt-14 pt-8 border-t border-white/10 grid grid-cols-2 md:grid-cols-4 gap-4 text-xs text-slate-300 font-medium">
                <div class="flex items-center justify-center gap-2">
                    <span class="text-brand-accent font-bold">✓</span>
                    <span>£10M Insured</span>
                </div>
                <div class="flex items-center justify-center gap-2">
                    <span class="text-brand-accent font-bold">✓</span>
                    <span>Dedicated Supervisor</span>
                </div>
                <div class="flex items-center justify-center gap-2">
                    <span class="text-brand-accent font-bold">✓</span>
                    <span>Full RAMS &amp; COSHH</span>
                </div>
                <div class="flex items-center justify-center gap-2">
                    <span class="text-brand-accent font-bold">✓</span>
                    <span>DBS-Vetted Staff</span>
                </div>
            </div>
        </div>
    </header>

    <!-- 2. The Solution: What We Deliver (Minimal & Punchy) -->
    <section class="py-20 md:py-24 bg-white border-b border-slate-200">
        <div class="max-w-5xl mx-auto px-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <div class="lg:col-span-6 space-y-6">
                    <div class="inline-flex items-center gap-3">
                        <span class="text-brand-900 text-[11px] tracking-[0.25em] uppercase font-semibold">Service Scope</span>
                        <div class="h-[1px] w-8 bg-slate-300"></div>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-900 uppercase leading-snug">
                        Consistent Standards for {location.name} Commercial Premises.
                    </h2>
                    <p class="text-brand-text font-light text-base leading-relaxed">
                        {location.description} Whether managing a single corporate floor or an entire commercial portfolio, we provide reliable, unobtrusive cleaning backed by measurable quality control.
                    </p>
                    
                    <ul class="space-y-3.5 pt-2">
                        {service.features.map(feature => (
                            <li class="flex items-start gap-3 text-sm text-slate-700">
                                <span class="text-brand-500 font-bold text-base leading-none mt-0.5">•</span>
                                <span>{feature}</span>
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="lg:col-span-6">
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 shadow-sm space-y-6">
                        <h3 class="text-xl font-heading font-bold text-brand-900 uppercase">
                            Operational Footprint
                        </h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Serving commercial offices, property management blocks, and industrial facilities across <strong class="text-brand-900 font-semibold">{location.name}</strong> and surrounding commercial areas.
                        </p>

                        <!-- Key Landmark & Corridor Coverage -->
                        {location.landmarks && location.landmarks.length > 0 && (
                            <div>
                                <h4 class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-2.5">
                                    Local Areas &amp; Landmarks
                                </h4>
                                <div class="flex flex-wrap gap-2">
                                    {location.landmarks.map(landmark => (
                                        <span class="px-3 py-1 bg-white border border-slate-200 rounded-md text-xs text-brand-900 font-medium">
                                            {landmark}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}

                        <!-- Nearby Coverage -->
                        {location.nearbyAreas && location.nearbyAreas.length > 0 && (
                            <div class="pt-4 border-t border-slate-200">
                                <h4 class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-2">
                                    Adjacent Response Zones
                                </h4>
                                <p class="text-xs text-slate-600 leading-relaxed">
                                    {location.nearbyAreas.join(' • ')}
                                </p>
                            </div>
                        )}
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 3. The 3-Step Journey (Clear & Frictionless) -->
    <section class="py-20 md:py-24 bg-slate-50 border-b border-slate-200">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <div class="inline-flex items-center gap-3 justify-center mb-3">
                    <span class="text-brand-900 text-[11px] tracking-[0.25em] uppercase font-semibold">How It Works</span>
                </div>
                <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-900 uppercase">
                    A Simple, Professional Journey
                </h2>
                <p class="text-slate-600 text-sm font-light mt-3 leading-relaxed">
                    From initial site review to seamless daily delivery, here is how we onboard your facility in {location.name}.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Step 1 -->
                <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm relative">
                    <span class="text-xs font-heading font-bold text-brand-accent tracking-widest uppercase block mb-3">Step 01</span>
                    <h3 class="text-xl font-heading font-bold text-brand-900 uppercase mb-3">Site Survey &amp; Quote</h3>
                    <p class="text-slate-600 text-sm font-light leading-relaxed">
                        We visit your {location.name} premises to assess your exact layout, traffic levels, and schedule requirements. You receive a clear, fixed-price proposal within 24 hours.
                    </p>
                </div>

                <!-- Step 2 -->
                <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm relative">
                    <span class="text-xs font-heading font-bold text-brand-accent tracking-widest uppercase block mb-3">Step 02</span>
                    <h3 class="text-xl font-heading font-bold text-brand-900 uppercase mb-3">Smooth Mobilisation</h3>
                    <p class="text-slate-600 text-sm font-light leading-relaxed">
                        We issue site-specific RAMS and COSHH documentation, assign directly employed, DBS-vetted operatives, and introduce your dedicated site supervisor before day one.
                    </p>
                </div>

                <!-- Step 3 -->
                <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm relative">
                    <span class="text-xs font-heading font-bold text-brand-accent tracking-widest uppercase block mb-3">Step 03</span>
                    <h3 class="text-xl font-heading font-bold text-brand-900 uppercase mb-3">Guaranteed Delivery</h3>
                    <p class="text-slate-600 text-sm font-light leading-relaxed">
                        Consistent, scheduled cleaning executed to defined SLAs. Your supervisor conducts regular audits to keep standards impeccably high without you having to micro-manage.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Frequently Asked Questions (Reassurance) -->
    <section class="py-20 md:py-24 bg-white border-b border-slate-200">
        <div class="max-w-3xl mx-auto px-6">
            <div class="text-center mb-14">
                <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-900 uppercase">
                    Common Questions
                </h2>
                <p class="text-slate-600 text-sm font-light mt-2">
                    Key information for business owners and facilities managers in {location.name}.
                </p>
            </div>

            <div class="space-y-6">
                <div class="border-b border-slate-200 pb-6">
                    <h3 class="text-base font-heading font-bold text-brand-900 uppercase mb-2">
                        How quickly can you start in {location.name}?
                    </h3>
                    <p class="text-slate-600 text-sm font-light leading-relaxed">
                        We typically conduct site surveys within 24 to 48 hours. For standard contracts, mobilization can occur within 3 to 7 working days, or faster for emergency callouts.
                    </p>
                </div>

                <div class="border-b border-slate-200 pb-6">
                    <h3 class="text-base font-heading font-bold text-brand-900 uppercase mb-2">
                        Are your cleaners directly employed and background checked?
                    </h3>
                    <p class="text-slate-600 text-sm font-light leading-relaxed">
                        Yes. All our cleaning operatives are directly employed, DBS background-vetted, fully uniformed, and trained in Health & Safety and COSHH compliance.
                    </p>
                </div>

                <div class="border-b border-slate-200 pb-6">
                    <h3 class="text-base font-heading font-bold text-brand-900 uppercase mb-2">
                        What health and safety standards do you operate to?
                    </h3>
                    <p class="text-slate-600 text-sm font-light leading-relaxed">
                        We hold £10M Public and Employers Liability insurance, issue comprehensive RAMS prior to commencement, and enforce strict COSHH and color-coded hygiene systems.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Clear Call to Action (The Final Step) -->
    <section class="py-20 bg-brand-900 text-white text-center">
        <div class="max-w-3xl mx-auto px-6">
            <h2 class="text-3xl md:text-4xl font-heading font-bold uppercase tracking-tight text-white mb-4">
                Ready to Upgrade Your Cleaning in {location.name}?
            </h2>
            <p class="text-slate-300 text-base font-light max-w-xl mx-auto leading-relaxed mb-8">
                Speak directly with our commercial contracts team. We will survey your premises, review your current requirements, and deliver a transparent proposal.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="/contact" class="bg-brand-accent text-brand-900 px-8 py-4 rounded-lg font-heading text-sm uppercase tracking-wider font-bold hover:bg-white transition-all shadow-lg">
                    Request a Quote
                </a>
                <a href="tel:02046206344" class="px-8 py-4 rounded-lg font-heading text-sm uppercase tracking-wider font-semibold border border-white/30 text-white hover:bg-white/10 transition-all flex items-center gap-2">
                    <i data-lucide="phone" class="w-4 h-4 text-brand-accent"></i>
                    <span>020 4620 6344</span>
                </a>
            </div>
        </div>
    </section>

    <Footer slot="footer" />
</BaseLayout>
