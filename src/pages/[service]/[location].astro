---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { LOCATIONS, SERVICES, type LocationData, type ServiceData } from '../../data/locations';

export function getStaticPaths() {
  const commercialServices = SERVICES.filter(s => s.division === 'commercial');
  const commercialLocations = LOCATIONS.filter(l => l.commercialFocus);

  const paths = [];

  for (const service of commercialServices) {
    for (const location of commercialLocations) {
      paths.push({
        params: {
          service: service.slug,
          location: location.slug
        },
        props: {
          service,
          location
        }
      });
    }
  }

  return paths;
}

interface Props {
  service: ServiceData;
  location: LocationData;
}

const { service, location } = Astro.props;

const pageTitle = `${service.name} in ${location.name}, ${location.county} | Parker's Commercial`;
const pageDescription = `Specialist ${service.name.toLowerCase()} in ${location.name} (${location.postcodes.join(', ')}). Serving commercial facilities, property blocks, and business parks. Request a free site survey.`;
const canonical = `https://parkerscommercial.co.uk/${service.slug}/${location.slug}`;

const localSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${service.name} in ${location.name}`,
  "serviceType": service.name,
  "provider": {
    "@type": "CleaningService",
    "name": "Parker's Commercial Cleaning",
    "telephone": "+442046206344",
    "url": "https://parkerscommercial.co.uk/"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": location.name,
    "addressRegion": location.county,
    "postalCode": location.postcodes
  },
  "description": pageDescription
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonical} schema={localSchema}>
    <Navbar slot="header" />

    <!-- Hero Section -->
    <header class="relative bg-brand-900 text-white py-20 lg:py-28 overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center opacity-25" style={`background-image: url('${service.heroImage}');`}></div>
        <div class="absolute inset-0 bg-gradient-to-r from-brand-900 via-brand-900/90 to-brand-900/70"></div>
        
        <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
            <div class="max-w-3xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-brand-accent/20 border border-brand-accent/40 rounded-full text-brand-accent text-xs font-semibold uppercase tracking-wider mb-6">
                    <span>{location.county} Commercial Hub &bull; {location.postcodes.join(', ')}</span>
                </div>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold uppercase tracking-tight text-white mb-6">
                    {service.name} <span class="text-brand-accent">{location.name}</span>
                </h1>
                <p class="text-lg md:text-xl text-slate-200 font-light leading-relaxed mb-8">
                    {service.leadParagraph} Tailored for facilities managers, block management companies, and corporate offices across {location.name} and surrounding areas.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="/contact" class="bg-brand-accent text-brand-900 px-8 py-4 rounded-lg font-heading text-sm uppercase tracking-wider font-bold hover:bg-white transition-all shadow-lg">
                        Request {location.name} Site Survey
                    </a>
                    <a href="tel:02046206344" class="px-8 py-4 rounded-lg font-heading text-sm uppercase tracking-wider font-semibold border border-white/30 text-white hover:bg-white/10 transition-all">
                        Call 020 4620 6344
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Key Service Features & Localized Scope -->
    <section class="py-20 bg-white border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div>
                    <span class="text-brand-accent text-xs uppercase tracking-[0.2em] font-bold block mb-3">Service Scope in {location.name}</span>
                    <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-900 uppercase mb-6">
                        Reliable Commercial Standards for {location.name} Facilities
                    </h2>
                    <p class="text-brand-text font-light leading-relaxed mb-6">
                        {location.description} We work with local freeholders, corporate business parks, and logistics operators across {location.landmarks.join(', ')}.
                    </p>
                    <ul class="space-y-4">
                        {service.features.map(feature => (
                            <li class="flex items-start gap-3 text-sm text-slate-700">
                                <span class="text-brand-accent font-bold text-lg">&check;</span>
                                <span>{feature}</span>
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-sm">
                    <h3 class="text-xl font-heading font-bold text-brand-900 uppercase mb-4">
                        Nearby Commercial Coverage
                    </h3>
                    <p class="text-xs text-slate-600 mb-6 leading-relaxed">
                        Operating daily throughout {location.name} and rapid response coverage across neighboring commercial districts:
                    </p>
                    <div class="flex flex-wrap gap-2 mb-8">
                        {location.nearbyAreas.map(area => (
                            <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-md text-xs font-medium text-brand-900">
                                {area}
                            </span>
                        ))}
                    </div>
                    <div class="p-4 bg-brand-900 text-white rounded-xl text-center">
                        <p class="text-xs font-light text-slate-300 mb-2">Need an immediate out-of-hours walkthrough in {location.name}?</p>
                        <a href="tel:02046206344" class="text-brand-accent font-heading text-lg font-bold hover:underline">
                            020 4620 6344
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Fast Quote Section -->
    <section class="py-20 bg-slate-50">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-3xl font-heading font-bold text-brand-900 uppercase mb-4">
                Arrange a Free Commercial Survey in {location.name}
            </h2>
            <p class="text-slate-600 text-sm max-w-xl mx-auto mb-8 font-light">
                Transparent SLA contracts, full health &amp; safety documentation (RAMS), and £10M Public Liability insurance.
            </p>
            <a href="/contact" class="inline-block bg-brand-accent text-brand-900 px-10 py-4 rounded-lg font-heading text-sm uppercase tracking-wider font-bold hover:bg-brand-900 hover:text-white transition-all shadow-md">
                Get In Touch With Our Team
            </a>
        </div>
    </section>

    <Footer slot="footer" />
</BaseLayout>
