---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { LOCATIONS, SERVICES } from '../data/locations';

const pageTitle = "Service Locations & Commercial Coverage Directory | Parker's";
const pageDescription = "Explore Parker's Commercial Cleaning locations across Greater London and Essex. Find localized commercial office cleaning, high-reach gutter vacuuming, block maintenance, and domestic services.";
const canonical = "https://parkerscommercial.co.uk/locations";

const commercialServices = SERVICES.filter(s => s.division === 'commercial');
const domesticServices = SERVICES.filter(s => s.division === 'domestic');

const londonCommercialHubs = LOCATIONS.filter(l => l.commercialFocus && l.county === 'Greater London');
const essexCommercialHubs = LOCATIONS.filter(l => l.commercialFocus && l.county === 'Essex');
const domesticVillages = LOCATIONS.filter(l => l.domesticFocus);

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Parker's Service Locations Directory",
  "description": pageDescription,
  "url": canonical,
  "provider": {
    "@type": "CleaningService",
    "name": "Parker's Commercial Cleaning",
    "telephone": "+442046206344",
    "url": "https://parkerscommercial.co.uk/"
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonical} schema={schema}>
    <Navbar slot="header" />

    <!-- Page Header -->
    <header class="bg-brand-900 text-white pt-24 pb-16 md:pt-36 md:pb-20 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10 text-center">
            <span class="inline-block px-3.5 py-1.5 bg-white/10 border border-white/15 rounded-full text-brand-accent text-xs font-semibold uppercase tracking-wider mb-4">
                Full Regional Coverage Directory
            </span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold uppercase tracking-tight text-white mb-6">
                Our Service Locations
            </h1>
            <p class="text-slate-300 text-base md:text-lg max-w-2xl mx-auto font-light leading-relaxed">
                Dedicated B2B commercial facilities care across prime London commercial districts, Essex business corridors, and domestic residential villages.
            </p>
        </div>
    </header>

    <!-- Main Directory Content -->
    <main class="py-16 md:py-24 bg-slate-50">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 space-y-20">

            <!-- Section 1: London Prime Commercial Districts -->
            <section class="bg-white border border-slate-200 rounded-2xl p-8 md:p-12 shadow-sm">
                <div class="max-w-3xl mb-10">
                    <span class="text-brand-500 text-xs uppercase tracking-[0.2em] font-bold block mb-2">Enterprise B2B Hubs</span>
                    <h2 class="text-2xl md:text-3xl font-heading font-bold text-brand-900 uppercase">
                        London Commercial Districts
                    </h2>
                    <p class="text-slate-600 text-sm font-light mt-2">
                        Serving multi-tenancy corporate towers, financial institutions, and logistics facilities across prime London postcodes.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {londonCommercialHubs.map(hub => (
                        <div class="border border-slate-200 rounded-xl p-6 bg-slate-50/50 hover:border-brand-500/40 hover:shadow-md transition-all">
                            <div class="flex items-start justify-between gap-3 mb-2">
                                <h3 class="font-heading font-bold text-lg text-brand-900 uppercase">
                                    {hub.name}
                                </h3>
                                <span class="text-[10px] px-2 py-0.5 bg-white border border-slate-200 rounded text-slate-600 font-medium">
                                    {hub.postcodes.join(', ')}
                                </span>
                            </div>
                            <p class="text-xs text-slate-600 font-light leading-relaxed mb-4">
                                {hub.description}
                            </p>

                            <div class="pt-4 border-t border-slate-200/80">
                                <p class="text-[11px] font-semibold text-brand-900 uppercase tracking-wider mb-2">
                                    Available Services:
                                </p>
                                <ul class="space-y-1.5 text-xs">
                                    {commercialServices.map(service => (
                                        <li>
                                            <a 
                                                href={`/${service.slug}/${hub.slug}`} 
                                                class="text-slate-700 hover:text-brand-500 hover:underline flex items-center gap-1.5"
                                            >
                                                <span class="text-brand-accent text-sm leading-none">•</span>
                                                <span>{service.name}</span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- Section 2: Essex Commercial Hubs -->
            <section class="bg-white border border-slate-200 rounded-2xl p-8 md:p-12 shadow-sm">
                <div class="max-w-3xl mb-10">
                    <span class="text-brand-500 text-xs uppercase tracking-[0.2em] font-bold block mb-2">Regional Commercial Care</span>
                    <h2 class="text-2xl md:text-3xl font-heading font-bold text-brand-900 uppercase">
                        Essex Commercial Hubs
                    </h2>
                    <p class="text-slate-600 text-sm font-light mt-2">
                        Serving property managers, corporate business parks, and regional medical facilities across Essex.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {essexCommercialHubs.map(hub => (
                        <div class="border border-slate-200 rounded-xl p-6 bg-slate-50/50 hover:border-brand-500/40 hover:shadow-md transition-all">
                            <div class="flex items-start justify-between gap-3 mb-2">
                                <h3 class="font-heading font-bold text-lg text-brand-900 uppercase">
                                    {hub.name}
                                </h3>
                                <span class="text-[10px] px-2 py-0.5 bg-white border border-slate-200 rounded text-slate-600 font-medium">
                                    {hub.postcodes.join(', ')}
                                </span>
                            </div>
                            <p class="text-xs text-slate-600 font-light leading-relaxed mb-4">
                                {hub.description}
                            </p>

                            <div class="pt-4 border-t border-slate-200/80">
                                <p class="text-[11px] font-semibold text-brand-900 uppercase tracking-wider mb-2">
                                    Available Services:
                                </p>
                                <ul class="space-y-1.5 text-xs">
                                    {commercialServices.map(service => (
                                        <li>
                                            <a 
                                                href={`/${service.slug}/${hub.slug}`} 
                                                class="text-slate-700 hover:text-brand-500 hover:underline flex items-center gap-1.5"
                                            >
                                                <span class="text-brand-accent text-sm leading-none">•</span>
                                                <span>{service.name}</span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- Section 3: Domestic Residential Villages -->
            <section class="bg-white border border-slate-200 rounded-2xl p-8 md:p-12 shadow-sm">
                <div class="max-w-3xl mb-10">
                    <span class="text-brand-500 text-xs uppercase tracking-[0.2em] font-bold block mb-2">Residential Division</span>
                    <h2 class="text-2xl md:text-3xl font-heading font-bold text-brand-900 uppercase">
                        Domestic Coverage (Essex Villages &amp; Towns)
                    </h2>
                    <p class="text-slate-600 text-sm font-light mt-2">
                        Spotless pure water window cleaning, gutter vacuum clearing, and driveway pressure washing across affluent Essex communities.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    {domesticVillages.map(village => (
                        <div class="border border-slate-200 rounded-xl p-5 bg-slate-50/50 hover:border-brand-500/40 hover:shadow-sm transition-all">
                            <h3 class="font-heading font-bold text-base text-brand-900 uppercase mb-1">
                                {village.name}
                            </h3>
                            <p class="text-[11px] text-slate-500 mb-3">
                                Postcodes: {village.postcodes.join(', ')}
                            </p>
                            <ul class="space-y-1 text-xs">
                                {domesticServices.map(service => (
                                    <li>
                                        <a 
                                            href={`/domestic/${service.slug}/${village.slug}`} 
                                            class="text-slate-700 hover:text-brand-500 hover:underline flex items-center gap-1.5"
                                        >
                                            <span class="text-brand-accent text-xs">•</span>
                                            <span>{service.name}</span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </section>

        </div>
    </main>

    <!-- Fast CTA Strip -->
    <section class="py-16 bg-brand-900 text-white text-center">
        <div class="max-w-4xl mx-auto px-6">
            <h2 class="text-3xl font-heading font-bold uppercase mb-4">
                Don't See Your Location Listed?
            </h2>
            <p class="text-slate-300 text-sm font-light max-w-xl mx-auto mb-8 leading-relaxed">
                We operate across all Greater London boroughs and Essex districts for commercial contracts and property portfolios. Contact our team to confirm dispatch availability.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="/contact" class="bg-brand-accent text-brand-900 px-8 py-3.5 rounded-lg font-heading text-xs uppercase tracking-wider font-bold hover:bg-white transition-all shadow-md">
                    Contact Our Operations Team
                </a>
                <a href="tel:02046206344" class="px-8 py-3.5 rounded-lg font-heading text-xs uppercase tracking-wider font-semibold border border-white/30 text-white hover:bg-white/10 transition-all flex items-center gap-2">
                    <i data-lucide="phone" class="w-4 h-4 text-brand-accent"></i>
                    <span>020 4620 6344</span>
                </a>
            </div>
        </div>
    </section>

    <Footer slot="footer" />
</BaseLayout>
