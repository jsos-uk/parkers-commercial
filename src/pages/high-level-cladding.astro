---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "High-Level & External Cladding Cleaning London & Essex | Parker's";
const pageDescription = "Specialist rope access, MEWP cherry picker, and high-reach cladding cleaning for multi-storey office buildings and commercial properties across London & Essex.";
const canonical = "https://parkerscommercial.co.uk/high-level-cladding";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://parkerscommercial.co.uk/high-level-cladding#service",
      "serviceType": "High-Level & Cladding Cleaning",
      "provider": {
        "@type": "CleaningService",
        "name": "Parker's Commercial Cleaning",
        "telephone": "+442046206344",
        "url": "https://parkerscommercial.co.uk/"
      },
      "areaServed": [
        {
          "@type": "AdministrativeArea",
          "name": "London"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Essex"
        }
      ],
      "description": "Professional high-reach external facade, cladding, and window cleaning for commercial buildings, office blocks, and enterprise centers in London and Essex."
    },
    {
      "@type": "FAQPage",
      "@id": "https://parkerscommercial.co.uk/high-level-cladding#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What methods do you use for high-level commercial facade and cladding cleaning?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We utilize ultra-pure water-fed pole systems up to 60ft from ground level, mobile elevating work platforms (MEWPs / cherry pickers), and IRATA-certified rope access for multi-storey commercial buildings."
          }
        },
        {
          "@type": "Question",
          "name": "Are your high-level operators certified and insured?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our operators hold valid IPAF, PASMA, and IRATA certifications. Every project includes comprehensive Risk Assessments and Method Statements (RAMS) and full specialist commercial liability insurance."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonical} schema={schema} >
    <Navbar slot="header"  />

    <!-- Dynamic Themed Navigation -->
    

    <!-- Subpage Hero (Tagged as Dark) -->
    <header data-theme="dark" class="pt-32 pb-16 md:pt-48 md:pb-24 bg-brand-900 border-b border-white/10 relative overflow-hidden">
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&amp;fit=crop&amp;w=1000&amp;q=80" alt="High Rise Modern Architecture" class="w-full h-full object-cover opacity-30 grayscale">
            <div class="absolute inset-0 bg-brand-900/80"></div>
        </div>
        <div class="max-w-7xl mx-auto px-6 lg:px-12 text-center reveal active relative z-10">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-4 uppercase tracking-tight">High-Level &amp; Cladding</h1>
            <p class="text-brand-accent text-sm tracking-[0.3em] uppercase font-semibold">Specialist Access Solutions</p>
        </div>
    </header>

    <!-- About Section (Tagged as Light) -->
    <section data-theme="light" class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
                <div class="reveal">
                    <div class="inline-flex items-center gap-4 mb-8">
                        <span class="text-brand-900 text-[10px] tracking-[0.3em] uppercase font-medium">Philosophy</span>
                        <div class="h-[1px] w-12 bg-slate-200"></div>
                    </div>
                    <h2 class="text-4xl md:text-5xl font-heading font-medium text-brand-900 mb-8 leading-tight">
                        Safely Reaching New Heights in Building Maintenance.
                    </h2>
                    <div class="space-y-6 text-brand-text font-light leading-relaxed">
                        <p>The exterior of your facility is the physical embodiment of your corporate identity. Over time, environmental pollutants, algae growth, and heavy traffic film severely degrade building facades, glass, and cladding, impacting your image and slowly corroding the building's substrate.</p>
                        <p>We deploy highly trained, IPAF-certified operators utilizing state-of-the-art access equipment to restore and preserve your building fabric. From high-reach water-fed pole systems for multi-story glazing to MEWP access for industrial cladding, we execute complex exterior cleaning safely and efficiently.</p>
                    </div>
                </div>
                <div class="relative reveal delay-200 h-full min-h-[400px] lg:min-h-[600px]">
                    <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&amp;fit=crop&amp;w=1000&amp;q=80" alt="Corporate Building Facade" class="absolute inset-0 w-full h-full object-cover ">
                </div>
            </div>
        </div>
    </section>

    <!-- Operational Methodology / Features (Tagged as Light) -->
    <section data-theme="light" class="py-24 bg-slate-50 border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="max-w-3xl mb-20 reveal">
                <div class="inline-flex items-center gap-4 mb-8">
                    <span class="text-brand-900 text-[10px] tracking-[0.3em] uppercase font-medium">Methodology</span>
                    <div class="h-[1px] w-12 bg-slate-300"></div>
                </div>
                <h2 class="text-4xl md:text-5xl font-heading font-medium text-brand-900 mb-6">Advanced Access &amp; Cleaning Solutions</h2>
                <p class="text-lg text-brand-text font-light leading-relaxed">Deploying the right equipment and expertise to handle any architectural or structural challenge.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                
                <div class="bg-white border border-slate-200 group overflow-hidden flex flex-col reveal hover:shadow-xl transition-shadow duration-500">
                    <div class="h-64 overflow-hidden relative border-b border-slate-200">
                        <img src="/images/cladding-restoration.jpg" alt="Facade &amp; Cladding Restoration" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    </div>
                    <div class="p-10 flex-1">
                        <span class="text-[10px] font-sans tracking-[0.2em] text-brand-accent block mb-4 group-hover:text-brand-900 transition-colors font-bold">01.</span>
                        <h3 class="text-2xl font-heading text-brand-900 mb-4 uppercase">Facade &amp; Cladding Restoration</h3>
                        <p class="text-brand-text font-light leading-relaxed text-sm">Specialist cleaning of aluminum, steel, and composite cladding. We remove biological growth, carbon deposits, and oxidation to restore original structural aesthetics.</p>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 group overflow-hidden flex flex-col reveal delay-100 hover:shadow-xl transition-shadow duration-500">
                    <div class="h-64 overflow-hidden relative border-b border-slate-200">
                        <img src="/images/pure-water-window-cleaning.jpg" alt="Pure Water Window Cleaning" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    </div>
                    <div class="p-10 flex-1">
                        <span class="text-[10px] font-sans tracking-[0.2em] text-brand-accent block mb-4 group-hover:text-brand-900 transition-colors font-bold">02.</span>
                        <h3 class="text-2xl font-heading text-brand-900 mb-4 uppercase">Pure Water Window Cleaning</h3>
                        <p class="text-brand-text font-light leading-relaxed text-sm">Utilizing advanced high-reach water-fed pole systems. We use purified, de-ionized water to deliver a flawless, streak-free finish without the need for ladders.</p>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 group overflow-hidden flex flex-col reveal delay-200 hover:shadow-xl transition-shadow duration-500">
                    <div class="h-64 overflow-hidden relative border-b border-slate-200 bg-slate-200">
                        <img src="/images/internal-high-level-dusting.jpg" alt="Internal High-Level Dusting" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    </div>
                    <div class="p-10 flex-1">
                        <span class="text-[10px] font-sans tracking-[0.2em] text-brand-accent block mb-4 group-hover:text-brand-900 transition-colors font-bold">03.</span>
                        <h3 class="text-2xl font-heading text-brand-900 mb-4 uppercase">Internal High-Level Dusting</h3>
                        <p class="text-brand-text font-light leading-relaxed text-sm">Specialist interior cleaning for warehouses and atriums, safely removing hazardous dust and debris from high structural beams, HVAC ductwork, and lighting rigs.</p>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 group overflow-hidden flex flex-col reveal hover:shadow-xl transition-shadow duration-500">
                    <div class="h-64 overflow-hidden relative border-b border-slate-200">
                        <img src="/images/high-level-gutter-cleaning.jpg" alt="Gutter &amp; Roof Clearance" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    </div>
                    <div class="p-10 flex-1">
                        <span class="text-[10px] font-sans tracking-[0.2em] text-brand-accent block mb-4 group-hover:text-brand-900 transition-colors font-bold">04.</span>
                        <h3 class="text-2xl font-heading text-brand-900 mb-4 uppercase">Gutter &amp; Roof Clearance</h3>
                        <p class="text-brand-text font-light leading-relaxed text-sm">High-powered, ground-operated vacuum systems equipped with camera technology to safely clear blockages from commercial guttering, preventing serious water damage.</p>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 group overflow-hidden flex flex-col reveal delay-100 hover:shadow-xl transition-shadow duration-500">
                    <div class="h-64 overflow-hidden relative border-b border-slate-200">
                        <img src="/images/scissor-lift-cherry.webp" alt="MEWP &amp; Aerial Access" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    </div>
                    <div class="p-10 flex-1">
                        <span class="text-[10px] font-sans tracking-[0.2em] text-brand-accent block mb-4 group-hover:text-brand-900 transition-colors font-bold">05.</span>
                        <h3 class="text-2xl font-heading text-brand-900 mb-4 uppercase">MEWP &amp; Aerial Access</h3>
                        <p class="text-brand-text font-light leading-relaxed text-sm">For complex architectural designs, we deploy Mobile Elevating Work Platforms (cherry pickers and scissor lifts) operated strictly by highly trained, certified personnel.</p>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 group overflow-hidden flex flex-col reveal delay-200 hover:shadow-xl transition-shadow duration-500">
                    <div class="h-64 overflow-hidden relative border-b border-slate-200">
                        <img src="/images/rope-access.webp" alt="Abseil &amp; Rope Access" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                    </div>
                    <div class="p-10 flex-1">
                        <span class="text-[10px] font-sans tracking-[0.2em] text-brand-accent block mb-4 group-hover:text-brand-900 transition-colors font-bold">06.</span>
                        <h3 class="text-2xl font-heading text-brand-900 mb-4 uppercase">Abseil &amp; Rope Access</h3>
                        <p class="text-brand-text font-light leading-relaxed text-sm">For extreme heights or areas inaccessible by MEWPs, our IRATA-certified rope access teams provide discreet, safe, and highly effective facade cleaning solutions.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Contractor Support / Site Safety Section (Tagged as Light) -->
    <section data-theme="light" class="py-24 bg-white border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
                <div class="lg:col-span-1 reveal">
                    <h3 class="text-4xl font-heading font-bold text-brand-900 mb-4 uppercase">Uncompromising Height Safety</h3>
                    <p class="text-brand-text font-light leading-relaxed">Working at height demands zero margin for error. Our high-level cleaning division operates under strict adherence to HSE regulations, ensuring risk-free execution on every project.</p>
                </div>
                <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-10">
                    <div class="flex gap-4 reveal delay-100">
                        <i data-lucide="shield-alert" class="w-8 h-8 text-brand-accent flex-shrink-0"></i>
                        <div>
                            <h5 class="font-heading text-2xl uppercase text-brand-900 mb-1">IPAF &amp; PASMA Certified</h5>
                            <p class="text-sm font-light text-brand-text leading-relaxed">All high-level operatives carry valid certifications for the safe assembly of mobile access towers and the operation of powered access equipment.</p>
                        </div>
                    </div>
                    <div class="flex gap-4 reveal delay-200">
                        <i data-lucide="clipboard-check" class="w-8 h-8 text-brand-accent flex-shrink-0"></i>
                        <div>
                            <h5 class="font-heading text-2xl uppercase text-brand-900 mb-1">Rigorous RAMS</h5>
                            <p class="text-sm font-light text-brand-text leading-relaxed">We provide comprehensive, site-specific Risk Assessments and Method Statements before a single piece of equipment is deployed.</p>
                        </div>
                    </div>
                    <div class="flex gap-4 reveal delay-100">
                        <i data-lucide="hard-hat" class="w-8 h-8 text-brand-accent flex-shrink-0"></i>
                        <div>
                            <h5 class="font-heading text-2xl uppercase text-brand-900 mb-1">Cordon &amp; Site Management</h5>
                            <p class="text-sm font-light text-brand-text leading-relaxed">Strict ground-level safety perimeters and out-of-hours scheduling are utilized to protect the public and ensure zero disruption to your daily operations.</p>
                        </div>
                    </div>
                    <div class="flex gap-4 reveal delay-200">
                        <i data-lucide="check-circle" class="w-8 h-8 text-brand-accent flex-shrink-0"></i>
                        <div>
                            <h5 class="font-heading text-2xl uppercase text-brand-900 mb-1">Full Insurance Coverage</h5>
                            <p class="text-sm font-light text-brand-text leading-relaxed">Our operations are fully backed by comprehensive public and employer liability insurance explicitly covering high-level specialist access.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call To Action (Tagged as Dark) -->
    <section data-theme="dark" class="py-24 bg-brand-900 border-t-[3px] border-brand-accent text-center">
        <div class="max-w-4xl mx-auto px-6 lg:px-12 reveal">
            <div class="inline-flex items-center gap-4 mb-8 justify-center">
                <div class="h-[1px] w-12 bg-white/20"></div>
                <span class="text-white/80 text-[10px] tracking-[0.3em] uppercase font-medium">Protect Your Building</span>
                <div class="h-[1px] w-12 bg-white/20"></div>
            </div>
            <h2 class="text-5xl md:text-6xl font-heading font-bold text-white mb-8 uppercase tracking-wide">Elevate Your Exterior Standards</h2>
            <p class="text-white/60 font-light text-lg mb-12 max-w-2xl mx-auto leading-relaxed">
                Restore and protect the value of your commercial property. Contact us today to arrange a full site survey and receive a detailed, competitive proposal for your high-level maintenance needs.
            </p>
            <a href="/contact" class="inline-block bg-white text-brand-900 px-8 py-4 rounded-lg font-heading text-base font-semibold uppercase tracking-wider hover:bg-brand-accent transition-all duration-300 shadow-lg hover:shadow-xl">
                Request Site Survey
            </a>
        </div>
    </section>

    <!-- Footer (Tagged as Dark) -->
    

    <!-- Mobile Sticky CTA Bar -->
    <div class="md:hidden fixed bottom-0 left-0 w-full z-50 flex border-t border-brand-900 shadow-2xl">
        <a href="tel:02046206344" class="flex-1 bg-white text-brand-900 py-4 font-semibold uppercase tracking-[0.1em] text-xs flex justify-center items-center gap-2">
            <i data-lucide="phone" class="w-4 h-4"></i> Call Now
        </a>
        <a href="/contact" class="flex-1 bg-brand-accent text-brand-900 py-4 font-semibold uppercase tracking-[0.1em] text-xs flex justify-center items-center gap-2">
            Get Quote
        </a>
    </div>

    <!-- Scripts -->

    <Footer slot="footer" />
</BaseLayout>
