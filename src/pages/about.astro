---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "About Us | 35+ Years Commercial Cleaning London & Essex | Parker's";
const pageDescription = "Discover Parker's Commercial Cleaning. Over 35 years delivering trusted, family-run office block, dental surgery, and commercial cleaning across London & Essex.";
const canonical = "https://parkerscommercial.co.uk/about";

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "mainEntity": {
    "@type": "CleaningService",
    "name": "Parker's Commercial Cleaning",
    "foundingDate": "1990",
    "telephone": "+442046206344",
    "url": "https://parkerscommercial.co.uk/",
    "areaServed": ["London", "Essex", "Greater London"]
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonical} schema={schema}>
    <Navbar slot="header" />

    <!-- Subpage Hero -->
    <header class="pt-32 pb-16 md:pt-48 md:pb-24 bg-brand-900 border-b border-white/10 relative overflow-hidden">
        <div class="absolute inset-0 z-0">
            <img src="/images/hero.jpg" alt="About Parker's" class="w-full h-full object-cover opacity-30 grayscale">
            <div class="absolute inset-0 bg-brand-900/80"></div>
        </div>
        <div class="max-w-7xl mx-auto px-6 lg:px-12 text-center relative z-10">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-4 uppercase tracking-tight">About Us</h1>
            <p class="text-brand-accent text-sm tracking-[0.3em] uppercase font-semibold">Parker's Commercial Cleaning</p>
        </div>
    </header>

    <!-- About Section -->
    <section class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
                <div>
                    <div class="inline-flex items-center gap-4 mb-8">
                        <span class="text-brand-900 text-[10px] tracking-[0.3em] uppercase font-medium">Our Story</span>
                        <div class="h-[1px] w-12 bg-slate-200"></div>
                    </div>
                    <h2 class="text-4xl md:text-5xl font-heading font-medium text-brand-900 mb-8 leading-tight">
                        Excellence is not a one-time task, it's an <span class="italic text-brand-500">ongoing requirement.</span>
                    </h2>
                    <div class="space-y-6 text-brand-text font-light leading-relaxed">
                        <p>For a busy commercial facility, cleanliness is paramount. Our contract maintenance services are designed to provide complete peace of mind, ensuring your premises are maintained to the highest standards, day in and day out.</p>
                        <p>We work as a seamless extension of your own team, developing a flexible and reliable cleaning schedule that protects your investment, enhances your brand image, and creates a pristine environment for your staff and clients.</p>
                    </div>
                    
                    <div class="mt-12 pt-12 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-10">
                        <div>
                            <h4 class="font-heading font-medium text-brand-900 text-3xl mb-3 uppercase tracking-wide">Modern Management</h4>
                            <p class="text-sm text-brand-text font-light leading-relaxed">Digital reporting, strict quality control, and reliable schedules ensure complete transparency.</p>
                        </div>
                        <div>
                            <h4 class="font-heading font-medium text-brand-900 text-3xl mb-3 uppercase tracking-wide">Dedicated Teams</h4>
                            <p class="text-sm text-brand-text font-light leading-relaxed">Consistent, fully vetted staff assigned specifically to your site to maintain operational security.</p>
                        </div>
                    </div>
                </div>
                <div class="relative h-full min-h-[600px]">
                    <img src="/images/hero.jpg" alt="Professional commercial cleaning staff in a modern office" class="absolute inset-0 w-full h-full object-cover">
                    <!-- Experience Badge -->
                    <div class="absolute bottom-0 left-0 bg-brand-900 p-10 z-20 text-white hidden md:block shadow-2xl">
                        <p class="font-heading font-bold text-6xl mb-2">35+</p>
                        <p class="text-[10px] font-semibold tracking-[0.2em] uppercase text-brand-accent">Years Experience</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call To Action -->
    <section class="py-24 bg-brand-900 border-t-[3px] border-brand-accent text-center">
        <div class="max-w-4xl mx-auto px-6 lg:px-12">
            <div class="inline-flex items-center gap-4 mb-8 justify-center">
                <div class="h-[1px] w-12 bg-white/20"></div>
                <span class="text-white/80 text-[10px] tracking-[0.3em] uppercase font-medium">Partner With Us</span>
                <div class="h-[1px] w-12 bg-white/20"></div>
            </div>
            <h2 class="text-5xl md:text-6xl font-heading font-bold text-white mb-8 uppercase tracking-wide">Ready to elevate your standards?</h2>
            <p class="text-white/60 font-light text-lg mb-12 max-w-2xl mx-auto leading-relaxed">
                Contact us today to arrange a site walk-through and let us tailor a high-performance cleaning strategy for your infrastructure.
            </p>
            <a href="/contact" class="inline-block bg-white text-brand-900 px-8 py-4 rounded-lg font-heading text-base font-semibold uppercase tracking-wider hover:bg-brand-accent transition-all duration-300 shadow-lg hover:shadow-xl">
                Contact Our Team
            </a>
        </div>
    </section>

    <Footer slot="footer" />
</BaseLayout>
