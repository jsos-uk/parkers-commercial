---
import { LOCATIONS } from '../data/locations';

const villages = LOCATIONS.filter(l => l.domesticFocus);
const londonCommercialHubs = LOCATIONS.filter(l => l.commercialFocus && l.county === 'Greater London');
const essexCommercialHubs = LOCATIONS.filter(l => l.commercialFocus && l.county === 'Essex');
---

<footer class="bg-slate-950 text-slate-300 pt-16 pb-12 border-t border-white/10 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        
        <!-- Trust Badges & Credentials Bar -->
        <div class="pb-10 border-b border-white/10 mb-12 grid grid-cols-2 md:grid-cols-4 gap-6">
            <div>
                <h5 class="text-white text-xs font-bold uppercase tracking-wider">£10M Insured</h5>
                <p class="text-[11px] text-slate-400">Public &amp; Employers Liability</p>
            </div>
            <div>
                <h5 class="text-white text-xs font-bold uppercase tracking-wider">35+ Years Proven</h5>
                <p class="text-[11px] text-slate-400">Family-Run London &amp; Essex</p>
            </div>
            <div>
                <h5 class="text-white text-xs font-bold uppercase tracking-wider">CQC &amp; COSHH</h5>
                <p class="text-[11px] text-slate-400">Strict Clinical Standards</p>
            </div>
            <div>
                <h5 class="text-white text-xs font-bold uppercase tracking-wider">DBS-Vetted Staff</h5>
                <p class="text-[11px] text-slate-400">Directly Employed &amp; Uniformed</p>
            </div>
        </div>

        <!-- Main Footer Links Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 mb-14">
            
            <div class="lg:col-span-3 space-y-4">
                <img src="/images/parkers-logo-long.png" alt="Parker's Commercial Cleaning" class="h-8 w-auto brightness-0 invert opacity-90">
                <p class="text-slate-400 text-xs leading-relaxed">
                    Premier B2B commercial office cleaning, property management block caretaking, high-reach gutter vacuuming, and clinical decontamination across prime London business districts and Essex commercial corridors.
                </p>
                <div class="pt-2 text-xs text-slate-400 space-y-1">
                    <p class="font-semibold text-white">Head Office: 020 4620 6344</p>
                    <p>Mon - Fri: 07:00 - 19:00 | 24/7 Out-of-Hours Emergency Service</p>
                    <p class="pt-2">
                        <a href="/locations" class="text-brand-accent hover:text-white transition-colors underline font-medium">
                            Browse All Service Locations &rarr;
                        </a>
                    </p>
                </div>
            </div>

            <!-- Column 2: Commercial Services -->
            <div class="lg:col-span-3">
                <h4 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-4">
                    Commercial Services
                </h4>
                <ul class="space-y-2 text-xs font-light">
                    <li><a href="/commercial-gutter-cleaning" class="hover:text-brand-accent transition-colors">Commercial Gutter Cleaning</a></li>
                    <li><a href="/property-management" class="hover:text-brand-accent transition-colors">Property &amp; Block Maintenance</a></li>
                    <li><a href="/commercial-industrial-cleaning" class="hover:text-brand-accent transition-colors">Corporate Office Cleaning</a></li>
                    <li><a href="/healthcare-sanitation-services" class="hover:text-brand-accent transition-colors">Healthcare &amp; Dental Surgery</a></li>
                    <li><a href="/warehouse-factory-cleaning" class="hover:text-brand-accent transition-colors">Warehouse &amp; Logistics Floors</a></li>
                    <li><a href="/high-level-cladding" class="hover:text-brand-accent transition-colors">High-Level Facade &amp; Cladding</a></li>
                    <li><a href="/post-construction-sparkle" class="hover:text-brand-accent transition-colors">Post-Construction Sparkle Cleans</a></li>
                </ul>
            </div>

            <!-- Column 3: Prime London Commercial Districts -->
            <div class="lg:col-span-3">
                <div class="flex items-center justify-between mb-4">
                    <h4 class="text-white font-heading font-semibold text-sm uppercase tracking-wider">
                        London Commercial
                    </h4>
                    <a href="/locations" class="text-[11px] text-brand-accent hover:text-white transition-colors underline font-medium">
                        All Locations &rarr;
                    </a>
                </div>
                <ul class="space-y-1.5 text-xs text-slate-400">
                    {londonCommercialHubs.map(hub => (
                        <li>
                            <a href={`/commercial-industrial-cleaning/${hub.slug}`} class="hover:text-brand-accent transition-colors">
                                {hub.name}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Column 4: Essex Commercial & Villages -->
            <div class="lg:col-span-3 space-y-6">
                <div>
                    <h4 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-3">
                        Essex Commercial Hubs
                    </h4>
                    <ul class="space-y-1.5 text-xs text-slate-400 mb-4">
                        {essexCommercialHubs.map(hub => (
                            <li>
                                <a href={`/commercial-industrial-cleaning/${hub.slug}`} class="hover:text-brand-accent transition-colors">
                                    {hub.name}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>

                <div>
                    <h4 class="text-white font-heading font-semibold text-xs uppercase tracking-wider mb-2">
                        Domestic Villages (Essex)
                    </h4>
                    <div class="flex flex-wrap gap-1">
                        {villages.map(village => (
                            <a href={`/domestic/window-cleaning/${village.slug}`} class="text-[10px] px-2 py-0.5 bg-white/5 hover:bg-brand-accent/20 hover:text-brand-accent rounded border border-white/10 transition-colors">
                                {village.name}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>

        <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
            <p>&copy; {new Date().getFullYear()} Parker's Commercial Cleaning Ltd. All rights reserved.</p>
            <p>
                Website designed by <a href="https://jsos.uk" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-brand-accent transition-colors font-medium underline underline-offset-4 decoration-white/20 hover:decoration-brand-accent">JS Office Solutions</a>
            </p>
        </div>
    </div>
</footer>
