# ----------------------------------------------------------------------
# Parker's Commercial Cleaning - Server Configuration & 301 Redirect Rules
# ----------------------------------------------------------------------

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]

# 3. Strip .html extension from URLs (301 redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/
RewriteRule ^([^.]+)\.html$ https://%{HTTP_HOST}/$1 [R=301,L]

# 4. Resolve extensionless URLs to their .html files internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 5. Fix legacy broken/WordPress and moved paths
Redirect 301 /property-management-specialist-services.html https://parkerscommercial.co.uk/property-management
Redirect 301 /property-management-specialist-services https://parkerscommercial.co.uk/property-management
Redirect 301 /services/property-management-specialist-services https://parkerscommercial.co.uk/property-management
Redirect 301 /results.html https://parkerscommercial.co.uk/case-studies

# 6. Legacy WordPress Categories and Taxonomy Redirects
RewriteRule ^category/(.*)$ /services [R=301,L]
RewriteRule ^services-2/(.*)$ /services [R=301,L]
RewriteRule ^author/(.*)$ /about [R=301,L]
RewriteRule ^home/(.*)$ /$1 [R=301,L]

# 7. Discard spam query strings
RewriteCond %{QUERY_STRING} ^.*$
RewriteCond %{REQUEST_URI} ^/(services|about|case-studies|contact|property-management)
RewriteRule ^(.*)$ /$1? [R=301,L]

# ----------------------------------------------------------------------
# Core Web Vitals & Cloudflare Edge Caching Directives
# ----------------------------------------------------------------------

# 8. Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 9. Browser & Cloudflare Edge Caching Headers (Expires / Cache-Control)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Favicons (1 Year)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts (1 Year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS & JS (1 Month with Cloudflare purge on deploy)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Cache-Control Headers for Static Media
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  
  # Cache-Control for CSS & JavaScript
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # Security & Performance Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
